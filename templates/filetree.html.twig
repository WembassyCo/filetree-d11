{#
/**
 * @file
 * Simple file tree template - w3schools style tree view.
 *
 * Available variables:
 * - files: Array of file/directory items.
 * - params: Configuration parameters.
 */
#}
{% if files %}
  <ul class="filetree-simple">
    {{ _self.render_items(files, 0) }}
  </ul>
{% else %}
  <p>{{ 'No files found.'|t }}</p>
{% endif %}

{% macro render_items(items, depth) %}
  {% for name, item in items %}
    {% if item.type == 'directory' %}
      <li class="filetree-folder">
        <span class="caret">{{ name }}</span>
        {% if item.children %}
          <ul class="nested">
            {{ _self.render_items(item.children, depth + 1) }}
          </ul>
        {% endif %}
      </li>
    {% else %}
      <li class="filetree-file">
        <a href="{{ item.url|default('#') }}" title="{{ name }}">{{ name }}</a>
      </li>
    {% endif %}
  {% endfor %}
{% endmacro %}
