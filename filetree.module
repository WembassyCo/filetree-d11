<?php

/**
 * @file
 * The filetree.module file for D11 compatibility.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_theme() for the filetree theme.
 */
function filetree_theme($existing, $type, $theme, $path): array {
  return [
    'filetree' => [
      'variables' => [
        'files' => [],
        'params' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_help().
 */
function filetree_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.filetree':
      return '<p>' . t('The File Tree module allows you to display an interactive list of files and folders using the [filetree] tag in formatted text. For more information, see the <a href=&quot;http://drupal.org/project/filetree&quot;>File Tree project page</a>.') . '</p>';
  }
  return '';
}

/**
 * Implements hook_filter_FILTER_process_alter().
 */
function filetree_filter_process_alter(array &$element, array &$context) {
  // Attach the filetree library when the filter is used.
  if (isset($element['#type']) && $element['#type'] === 'text_format') {
    $element['#attached']['library'][] = 'filetree/filetree';
  }
}
